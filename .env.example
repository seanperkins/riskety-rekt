# Riskety Rekt environment.
#
# NOTHING IN THIS PROJECT LOADS A .env FILE. There is no dotenv dependency and
# no loader -- every entrypoint reads process.env directly. This file is a
# template for the two places the variables actually come from:
#
#   production   /etc/riskety-rekt/env, mode 0600, read by systemd
#                `EnvironmentFile=` in every unit under deploy/
#   local        `set -a; source .env; set +a` before an npm run
#
# The format is systemd EnvironmentFile syntax, which is also source-able:
# KEY=value, no `export`, no quotes, no interpolation.
#
# An EMPTY VALUE COUNTS AS UNSET everywhere, on purpose. A blank line in an
# EnvironmentFile yields "", and treating that as present is how a bot boots
# with signature verification effectively disabled. Every reader rejects both.

# --- required by every job, the bot and the web app -------------------------
# Absolute path. The droplet uses /srv/riskety-rekt/data/riskety.db.
RR_DB_PATH=./riskety.db
RR_SEASON_ID=season-1

# --- required by the Slack bot (src/slack/env.ts refuses to start without) ---
# The public origin of the web app, NO TRAILING SLASH -- the bot builds /login
# magic links from it, and a trailing slash 404s every one of them.
RR_WEB_URL=https://riskety.com
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-
# Slack workspace id, and the one channel the game reads. Both are scope
# checks: an event from anywhere else is dropped.
SLACK_TEAM_ID=T01ABCDEF
SLACK_CHANNEL_ID=C01ABCDEF

# --- load-bearing on the droplet, not read by application code --------------
# systemd OnCalendar resolves against the SYSTEM timezone, so 08:00 must mean
# 08:00 in New York or the slate is snapshotted an hour off for half the year.
# The application's own date arithmetic is pinned regardless (src/time.ts).
TZ=America/New_York

# --- optional ---------------------------------------------------------------
# Ports. The bot holds 3001 and the web app 3002; both default correctly, and
# neither is reachable from outside -- Caddy proxies over loopback.
# PORT=3002

# Leaving SLACK_BOT_TOKEN unset is a supported mode: publish-slate then writes
# the slate to the database without announcing it, and the tick resolves and
# saves without posting a recap. Useful for a dry run.

# No variable here may begin with NEXT_PUBLIC_. Next.js inlines those into the
# browser bundle; loadSlackEnv asserts it at boot and refuses to start.

# NOT an application variable: DO_PERSONAL_ACCESS_TOKEN, which doctl reads.
# Nothing in src/ references it. Keep it somewhere else if you can.
