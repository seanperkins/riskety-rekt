# Caddy config for Riskety Rekt.
#
# Install to /etc/caddy/Caddyfile. Caddy obtains and renews the certificate
# itself over ACME, which needs port 80 reachable and the A record already
# pointing here -- so this file is inert until DNS resolves to the droplet.
#
# DNS is at DigitalOcean. riskety.com is registered at Namecheap but its
# nameservers are delegated to ns{1,2,3}.digitalocean.com, so the A records live
# in the DO zone and `doctl compute domain records` is the way to change them.
# The registrar holds the delegation and nothing else.
#
# TLS is not a nicety here. Session cookies are Secure, so over plain HTTP the
# browser silently discards the cookie and every player bounces back to the
# sign-in page with no error to read.

# www redirects rather than serving. Two live origins would mean two cookie
# jars, and a player who signed in on one and opened a link to the other would
# be told to sign in again with no way to tell why.
www.riskety.com {
	redir https://riskety.com{uri} permanent
}

# The demo board: a fake ten-player season for showing the game to people who
# are not in it. Its own database FILE, not merely its own season id -- the
# roster table is keyed by slack_user_id with no season column, so fake players
# living in the production database would be dealt into the real season.
demo.riskety.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3003
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		# A fake board with invented players has no business in a search index.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

riskety.com {
	encode zstd gzip

	# Everything Slack-facing goes to Bolt, which serves it ALL on
	# /slack/events -- events, the /login slash command, and interactivity
	# alike. There is no separate command endpoint to route to, so the whole
	# /slack/* prefix is forwarded rather than one path: a misconfigured URL in
	# the Slack app then reaches Bolt and gets a real answer, instead of being
	# handed to the player app and 404ing in a way that looks like an outage.
	#
	# This must NOT be Socket Mode. createSlackApp builds a plain HTTP receiver
	# with no appToken; with Socket Mode enabled in the Slack app, Slack stops
	# delivering over HTTP entirely and this route goes quiet with no error.
	handle /slack/* {
		reverse_proxy 127.0.0.1:3001
	}

	# Everything else is the player app.
	handle {
		reverse_proxy 127.0.0.1:3002
	}

	# A raw token appears in the PATH of /login/:token -- not the query string.
	# Logging it would put a live credential in a file that outlives its
	# ten-minute TTL and gets read by anyone debugging the box, which is the one
	# place the design says a raw token must never land.
	#
	# `regexp` rather than deleting the field: every other route stays legible,
	# and only the token itself is replaced.
	log {
		output file /var/log/caddy/riskety.log {
			roll_size 10mb
			roll_keep 5
		}
		format filter {
			wrap console
			fields {
				request>uri regexp "/login/[^/?]+" "/login/REDACTED"
			}
		}
	}

	header {
		# The board is per-viewer and secret. No shared cache may hold it.
		Cache-Control "no-store"
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
