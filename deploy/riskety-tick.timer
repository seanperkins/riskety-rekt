[Unit]
Description=Riskety Rekt — midnight tick

[Timer]
# 00:05:30, and both parts of that are load-bearing.
#
# The five minutes are Slack delivery grace. The cutoff is frozen at exactly
# 00:00:00 by tickInstant() and does NOT move with this timer, so a workout
# posted at 23:59:58 and delivered at 00:00:03 still lands in the table before
# the tick's transaction reads it, and still belongs to the day that just
# closed. Firing at 00:00:00 would leave that post valid by its Slack timestamp
# but absent from the read — and it could not fall into the next day either,
# because its ET date belongs to this one.
#
# The :30 is the older reason. The settlement poller fires at *:00/30, and its
# write loop would otherwise be able to interleave with the tick's read of the
# settlements table — which tick_context then makes permanently authoritative
# for that day. The poller's loop is transactional now, so this offset is the
# second layer, not the only one.
#
# DEPLOY ORDER: this file must not land before the code that moves the
# boundary. Both halves of a partial deploy are bad, in different ways.
#
# This timer with OLD code STALLS the season outright: the 00:05 run computes
# today, hits before-cutoff, skips, and there is no 21:00 run left to catch it.
#
# New code with a stale 21:00 timer does not stall, but it is NOT the harmless
# no-op an earlier version of this comment claimed. Only the first night is a
# no-op (it computes yesterday and sees already-run). From the second night on,
# each 21:00 firing legally resolves the day that ended at midnight — 21 hours
# late — so the season runs permanently a day behind, posting every recap 21
# hours after its own deadline, with every guard silent and nothing in the logs
# to say so. It self-heals the moment this file lands, and no day is lost or
# double-resolved, but an operator reading "harmless" would not go looking.
#
# The zone comes from the system TZ, like every other unit here. An inline
# OnCalendar zone would be a second place for the season's clock to live, and
# the whole design turns on one.
OnCalendar=*-*-* 00:05:30
Persistent=false

[Install]
WantedBy=timers.target
